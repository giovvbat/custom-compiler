class MainArray {
    public static void main(String[] args) {
        System.out.println(new Processador().executar(4));
    }
}

class Animal {
    int idade ;

    public int getIdade() {
        return idade ;
    }
}

class Cachorro extends Animal {
    public int getIdade() {
        return idade ;
    }
}

class Processador {
    int[] numeros ;
    Animal animal ;

    public int executar(int tamanho) {
        int i ;
        int total ;
        boolean valido ;

        i = 0 ;
        total = 0 ;

        while (i < tamanho) {
            numeros[i] = i * i ;
            i = i + 1 ;
        }

        i = 0 ;
        while (i < numeros.length) {
            total = total + numeros[i] ;
            i = i + 1 ;
        }

        valido = 0 < total ;
        animal = new Cachorro() ;

        if (valido) {
            total = total + animal.getIdade() ;
        } else {
            total = 0 ;
        }

        return total ;
    }
}
